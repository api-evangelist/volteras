                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Page token used for pagination."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Listing filter schema."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicle_id",
                  "description": "(Required) Unique internal identifier for the vehicle."
                }
