{
  "opencollection": "1.0.0",
  "info": {
    "name": "VOLTERAS CONNECT Accounts Vehicle Eligibility API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Vehicle Eligibility",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk Vin Eligibility Check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.volteras.com/v1/vehicles/eligibility",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Check the eligibility of multiple VINs\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- NOT_PERMITTED\n- REQUEST_VALIDATION_ERROR\n- SERVER_ERROR"
        },
        {
          "info": {
            "name": "Bulk Vehicle Eligibility Check Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.volteras.com/v1/vehicles/eligibility/:id/results",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "maxPageSize",
                "value": "",
                "type": "query",
                "description": "Max size of the returned list."
              },
              {
                "name": "currentPage",
                "value": "",
                "type": "query",
                "description": "Current page"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the eligibility results for all VINs that were sent in a request\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- NOT_PERMITTED\n- REQUEST_VALIDATION_ERROR\n- RESOURCE_NOT_FOUND\n- SERVER_ERROR"
        }
      ]
    }
  ],
  "bundled": true
}