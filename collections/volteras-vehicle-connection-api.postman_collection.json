        {
          "id": "92b86303-6454-49be-a572-e19805ef7068",
          "name": "Action Disconnect",
          "request": {
            "name": "Action Disconnect",
            "description": {
              "content": "This endpoint allows you to disconnect a specific vehicle from your organization, ceasing the synchronization of its data.\nAfter disconnection, the vehicle will no longer be accessible through your organization's account.\nNote that it can take a few minutes for the disconnection to be processed.\n\n**Note:**\n- Disconnecting a vehicle is an irreversible action, and the vehicle's data will no longer be synchronized with your organization.\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- REQUEST_VALIDATION_ERROR\n- RESOURCE_NOT_FOUND\n- SERVER_ERROR",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "vehicles",
                ":vehicle_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicle_id",
                  "description": "(Required) Unique internal identifier for the vehicle."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
