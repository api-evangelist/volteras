      },
      "item": [
        {
          "id": "105a78e6-5d6e-489c-97c4-831d0d5aa2ce",
          "name": "Auth Token",
          "request": {
            "name": "Auth Token",
            "description": {
              "content": "Obtain OAuth 2.0 access token. This endpoint follows the OAuth 2.0 industry-standard protocol for authorization.\nIt performs authorization and returns the access token and refresh token.\n\nTo use, pass the `grant_type` in the form data, which will be:\n- `client_credentials` grant type to authenticate with `client_id` and `client_secret`.\n- `refresh_token` grant type to refresh an existing token.\n\nIf using `client_credentials` grant type, please use HTTP Basic Auth to pass the credentials\n(with the username being the `client_id` and the password being the `client_secret`).\n\nThe `client_id` and `client_secret` can be passed in the form data, but this is deprecated and\nnot recommended.\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- REQUEST_VALIDATION_ERROR\n- SERVER_ERROR",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "Your client ID."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "Your client secret."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "The refresh token acquired during authentication with the `client_credentials` `grant_type`."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "OAuth 2.0 grant type."
                }
              ]
            }
          },
          "response": [
            {
              "id": "e590c985-53e8-417d-9c8f-b6d54b1421d4",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "oauth2",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "Your client ID.",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Your client secret.",
                        "type": "text/plain"
                      },
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "The refresh token acquired during authentication with the `client_credentials` `grant_type`.",
                        "type": "text/plain"
                      },
                      "key": "refresh_token",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "OAuth 2.0 grant type.",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"string\",\n  \"expires_in\": 1804,\n  \"refresh_token\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "156a48e0-ef2c-45a0-bb20-01b1b56c7490",
          "name": "Test Token",
          "request": {
            "name": "Test Token",
            "description": {
              "content": "This endpoint validates the access token and retrieves the associated `clientId` and `organizationId`.\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- REQUEST_VALIDATION_ERROR\n- SERVER_ERROR",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "test-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "/v1/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
          "response": [
            {
              "id": "c68dff30-abb2-4f04-b8eb-d50fe5bf53ff",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
