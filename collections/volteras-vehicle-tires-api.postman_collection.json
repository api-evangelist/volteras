          "id": "ab488ef8-b7d3-41ec-ac84-9fd2287e506e",
          "name": "Get Vehicle Tires Readings Historic",
          "request": {
            "name": "Get Vehicle Tires Readings Historic",
            "description": {
              "content": "Retrieves the list of tire pressures for the vehicle for the specified period (default is the last 3 months),\ngrouped by hour.\n\nMaximum date range is 3 months.\n\n**Returns:**\n- The list of tire pressures for the vehicle.\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- REQUEST_VALIDATION_ERROR\n- RESOURCE_NOT_FOUND\n- SERVER_ERROR",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "vehicles",
                ":vehicle_id",
                "maintenance",
                "tires",
                "historic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from_datetime",
                  "value": "<string>",
                  "description": "Start datetime for the tire pressure history, in ISO format. Date range must be 3 months or less."
                },
                {
                  "disabled": false,
                  "key": "to_datetime",
                  "value": "<string>",
                  "description": "End datetime for the tire pressure history, in ISO format. Date range must be 3 months or less."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicle_id",
                  "description": "(Required) Unique internal identifier for the vehicle."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "/v1/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
