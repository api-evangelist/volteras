{
  "opencollection": "1.0.0",
  "info": {
    "name": "VOLTERAS CONNECT Accounts Vehicle Alerts API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Vehicle Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Vehicle Alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.volteras.com/v1/vehicles/:vehicle_id/alerts",
            "params": [
              {
                "name": "vehicle_id",
                "value": "",
                "type": "path",
                "description": "Unique internal identifier for the vehicle."
              },
              {
                "name": "maxPageSize",
                "value": "",
                "type": "query",
                "description": "Max size of the returned list."
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Page token used for pagination."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Listing filter schema."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve alerts for a vehicle based on its unique ID.\n\n\nPossible Codes in Error Response (see [Errors](https://docs.volteras.com/api-reference/errors) for error response schema and meaning of codes):\n\n- AUTHENTICATION_ERROR\n- PAGE_SIZE_TOO_LARGE\n- PAGINATED_QUERY_FILTER_CHANGED\n- REQUEST_VALIDATION_ERROR\n- RESOURCE_NOT_FOUND\n- SERVER_ERROR"
        }
      ]
    }
  ],
  "bundled": true
}